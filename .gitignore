# Dependências
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Builds / empacotamento
dist/
build/
release/
out/

# Dados do usuário (gerados em runtime)
data/
database/
logs/
src/logs/
*.log
*.db.bak
*.db.tmp

# Configuração local real (versionar apenas os exemplos config/*.example.json)
/config/*
!/config/*.example.json

# Pacotes e arquivos locais
*.zip

# LUTs embutidas: as .cube só entram no Git depois de a procedência/licença ser confirmada
# (resources/luts-embutidas/PROCEDENCIA.json). Ao confirmar, apague a linha abaixo.
resources/luts-embutidas/*.cube

# Documentação interna (README*.md, LICENSE e docs novos continuam versionáveis)
/.docs/
/_Archives/

# Sessão e cookies temporários
Partitions/
Cookies
Cookies-journal

# Segredos
.env
.env.*
*.pem
*.key
*.cert

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Temporários / testes manuais
*.CR2
.Teste imagem corrompida/
.tmp-clone-check/

# Caches de build restaurados pelos workflows (electron-builder/Electron)
/.cache/

# Gerado no build (licença do instalador (UTF-16), gerada do LICENSE)
installer/license-nsis.txt
# Ferramenta local (não faz parte do projeto)
/.freebuff/
